# Public BNB Smart Chain Testnet configuration
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=https://testnet.bscscan.com

# Server-only values. Never expose private keys through NEXT_PUBLIC_ variables.
SERVER_RPC_URL=

# Dedicated server-side demo signers. Generate with npm run demo:signers.
AGORA_AGENT_PRIVATE_KEY=
AGORA_MERCHANT_PRIVATE_KEY=
AGORA_RELAYER_PRIVATE_KEY=
AGORA_INTERNAL_TOKEN=

# Optional Gemini planner. Leave fixture mode for an offline demo.
AGORA_PLANNER_MODE=fixture
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
